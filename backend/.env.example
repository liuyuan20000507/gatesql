# 复制本文件为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会提交。

# 大模型接口（OpenAI 兼容格式）
# 火山方舟示例: https://ark.cn-beijing.volces.com/api/v3
# DeepSeek 示例: https://api.deepseek.com/v1
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=在这里填你的key
LLM_MODEL=在这里填模型名

# 数据库路径，相对于 backend/ 目录
DB_PATH=../data/shop.db

# Agent 行为参数
MAX_RETRY=3
MAX_ROWS=1000
QUERY_TIMEOUT=5

# 允许跨域的前端地址
CORS_ORIGINS=http://localhost:3000
